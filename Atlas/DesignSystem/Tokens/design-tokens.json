  "pricing": {
    "$description": "Pricing's map, histogram and change pill (README-Redesign, board 73; handoff 2026-11-25: color.priceLevel, color.priceChart, pill.change). The map's colours are the priceLevel0…4 and priceLevelLabel0…4 Color Sets above (color holds Color Sets only); PriceLevel and PriceChange+Pill in DesignSystem/Tokens/Pricing read them.",
    "priceLevel": {
      "use": "Pricing map only: how a price feels for local incomes compared with the US base price (feels-like ratio). Diverging: blue cheaper, neutral gray about the same, orange pricier. Each tile also carries its code and ratio as text, so colour is never the only signal. Validated per arm with the dataviz ordinal check (light and dark).",
      "steps": [
        "< 0.7×",
        "0.7–0.9×",
        "0.9–1.15×",
        "1.15–1.6×",
        "≥ 1.6×"
      ],
      "bounds": [
        0.7,
        0.9,
        1.15,
        1.6
      ],
      "suggestionRing": "aiFill, 2 pt inside the tile, where a suggestion waits"
    },
    "priceChart": {
      "use": "Pricing histogram: countries per $5 of price in US$.",
      "now": "systemGray",
      "suggested": "aiFill",
      "baseLine": "label3, 1 pt dashed, at the US base price"
    },
    "pillChange": {
      "use": "Change of a price in the Pricing table and popover.",
      "decrease": "neutral gray pill with arrowtriangle.down.fill",
      "increase": "warn pill (amber) with arrowtriangle.up.fill — increases can cost subscribers"
    }
